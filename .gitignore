/social_prompts/

# API keys. NEVER commit. CI uses GitHub Actions secrets instead.
.env
.env.*
!.env.example

# Internal/private notes — never push. Public README.md replaces this.
EXPLAINED.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Model cache
.cache/

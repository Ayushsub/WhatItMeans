# Copy to .env and fill in. At least ONE key is required; two or more gives
# you failover, which is the whole point of the router.
#
# Groq   https://console.groq.com/keys      14,400 req/day, no credit card
# Gemini https://aistudio.google.com/apikey 250-1,500 req/day
# OpenRouter (optional) https://openrouter.ai/keys

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

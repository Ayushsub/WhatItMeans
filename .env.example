# Copy to .env and fill in. At least ONE key is required; more gives you both
# failover AND more daily token headroom, which is the constraint that actually
# bites — see the note at the top of llm/providers.py.
#
# Verify what your keys can actually reach:  python -m llm.providers
#
# Groq      https://console.groq.com/keys       no card. Fast, but per-model
#                                               token/day caps are low
#                                               (70b: 100K TPD, 120b: 200K TPD).
# Gemini    https://aistudio.google.com/apikey  ~1,500 req/day on Flash.
# Cerebras  https://cloud.cerebras.ai           ~1M tokens/day per model, no
#                                               card. Biggest free headroom.
#                                               Free tier caps context at 8K.
# Mistral   https://console.mistral.ai          most generous quota, BUT the
#                                               free tier requires opting into
#                                               training on your data. Optional.
# OpenRouter https://openrouter.ai/keys         aggregates other free models.

GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
